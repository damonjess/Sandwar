extends Node

## WAV-based RTS audio manager.
##
## All combat sounds come from res://assets/sfx. The manager owns a bounded pool
## of world players plus a small non-positional UI pool, applies per-sound
## cooldowns and concurrency caps, and jitters pitch/volume so repeated fire
## does not turn into a machine-gun of identical samples.
##
## Generated by tools/generate_sfx.py. Re-import the project after regenerating.

const SOUND_FILES := {
	"cannon": ["cannon_01.wav", "cannon_02.wav"],
	"rocket_launch": ["rocket_launch_01.wav", "rocket_launch_02.wav"],
	"rifle": ["rifle_01.wav", "rifle_02.wav"],
	"mg_burst": ["mg_burst.wav"],
	"explosion_small": ["explosion_small_01.wav", "explosion_small_02.wav"],
	"explosion_medium": ["explosion_medium_01.wav", "explosion_medium_02.wav"],
	"explosion_building": ["explosion_building.wav"],
	"build_place": ["build_place.wav"],
	"ui_click": ["ui_click.wav"],
	"build_ready": ["build_ready.wav"],
	"comms_blip": ["comms_blip.wav"],
	"low_power": ["low_power.wav"],
}

## Minimum gap between two instances of the same logical sound, in milliseconds.
const COOLDOWN_MS := {
	"rifle": 45,
	"mg_burst": 55,
	"cannon": 60,
	"rocket_launch": 80,
	"explosion_small": 60,
	"explosion_medium": 90,
	"explosion_building": 250,
	"build_place": 90,
	"ui_click": 40,
	"build_ready": 200,
	"comms_blip": 55,
	"low_power": 2500,
}

## Per-sound concurrency caps keep a 15-unit firefight inside the voice pool.
const MAX_CONCURRENT := {
	"rifle": 4,
	"mg_burst": 4,
	"cannon": 3,
	"rocket_launch": 3,
	"explosion_small": 4,
	"explosion_medium": 3,
	"explosion_building": 1,
	"build_place": 2,
	"ui_click": 2,
	"build_ready": 1,
	"comms_blip": 2,
	"low_power": 1,
}

const WORLD_VOICES := 12
const UI_VOICES := 4
const BUS_NAME := "SFX"
const WORLD_ATTENUATION := 1.7
const PAN_STRENGTH := 0.7

## --- Easy tweak points -------------------------------------------------------
## Bus volume for every WAV-based effect. Set MUTE_ALL_AUDIO to true to silence
## the whole game (including the legacy ambience) without deleting assets.
const SFX_BUS_VOLUME_DB := -4.0
const MUTE_ALL_AUDIO := false

const PITCH_MIN := 0.92
const PITCH_MAX := 1.08
const VOLUME_JITTER_DB := 1.2

var streams: Dictionary = {}
var world_players: Array[AudioStreamPlayer2D] = []
var ui_players: Array[AudioStreamPlayer] = []
var world_i := 0
var ui_i := 0
var last_ms: Dictionary = {}
var rng := RandomNumberGenerator.new()
var _world_distance := 900.0

func _exit_tree() -> void:
	# Release active playbacks and stream references before the audio server tears
	# down, so a last typewriter blip cannot leave an orphan at quit.
	stop_all()
	streams.clear()

func _ready() -> void:
	rng.randomize()
	_setup_bus()
	_load_streams()
	_make_pool()
	_refresh_world_distance()
	var viewport := get_viewport()
	if viewport != null and not viewport.size_changed.is_connected(_refresh_world_distance):
		viewport.size_changed.connect(_refresh_world_distance)

## Positional combat/effect sound.
func play_at(id: String, pos: Vector2, volume_db := 0.0, pitch := 1.0) -> void:
	if MUTE_ALL_AUDIO or not _can_play(id):
		return
	if _active_count(world_players, id) >= int(MAX_CONCURRENT.get(id, 2)):
		return
	var player := _next_world_player()
	if player == null:
		return
	var stream = _pick_stream(id)
	if stream == null:
		return
	player.stream = stream
	player.global_position = pos
	player.volume_db = volume_db + rng.randf_range(-VOLUME_JITTER_DB, VOLUME_JITTER_DB)
	player.pitch_scale = clampf(pitch * rng.randf_range(PITCH_MIN, PITCH_MAX), 0.75, 1.25)
	player.set_meta("sfx_id", id)
	player.play()

## Non-positional UI/feedback sound. Building placement deliberately uses this
## pool so it stays crisp and centered instead of panning around the battlefield.
func play_ui(id: String, volume_db := 0.0, pitch := 1.0) -> void:
	if MUTE_ALL_AUDIO or not _can_play(id):
		return
	if _active_count(ui_players, id) >= int(MAX_CONCURRENT.get(id, 1)):
		return
	var player := _next_ui_player()
	if player == null:
		return
	var stream = _pick_stream(id)
	if stream == null:
		return
	player.stream = stream
	player.volume_db = volume_db + rng.randf_range(-0.5, 0.5)
	player.pitch_scale = clampf(pitch * rng.randf_range(0.97, 1.03), 0.9, 1.1)
	player.set_meta("sfx_id", id)
	player.play()

func _can_play(id: String) -> bool:
	if not streams.has(id):
		return false
	var now := Time.get_ticks_msec()
	var gap := int(COOLDOWN_MS.get(id, 0))
	if now - int(last_ms.get(id, -100000)) < gap:
		return false
	last_ms[id] = now
	return true

func _pick_stream(id: String):
	var choices: Array = streams.get(id, [])
	if choices.is_empty():
		return null
	return choices[rng.randi_range(0, choices.size() - 1)]

func _next_world_player() -> AudioStreamPlayer2D:
	for offset in world_players.size():
		var idx := (world_i + offset) % world_players.size()
		var player: AudioStreamPlayer2D = world_players[idx]
		if not player.playing:
			world_i = (idx + 1) % world_players.size()
			return player
	return null

func _next_ui_player() -> AudioStreamPlayer:
	for offset in ui_players.size():
		var idx := (ui_i + offset) % ui_players.size()
		var player: AudioStreamPlayer = ui_players[idx]
		if not player.playing:
			ui_i = (idx + 1) % ui_players.size()
			return player
	return null

func _active_count(players: Array, id: String) -> int:
	var count := 0
	for player in players:
		if player.playing and String(player.get_meta("sfx_id", "")) == id:
			count += 1
	return count

func _on_player_finished(player) -> void:
	player.set_meta("sfx_id", "")

## Scene changes call this so a battle's gunfire cannot bleed into the next
## mission or the strategic map. The pooled players stay alive for reuse.
func stop_all() -> void:
	for player in world_players:
		player.stop()
		player.stream = null
		player.set_meta("sfx_id", "")
	for player in ui_players:
		player.stop()
		player.stream = null
		player.set_meta("sfx_id", "")

# ------------------------------------------------------------------ setup

func _setup_bus() -> void:
	var master := AudioServer.get_bus_index("Master")
	if master >= 0:
		AudioServer.set_bus_mute(master, MUTE_ALL_AUDIO)
		if not _has_limiter(master):
			var limiter := AudioEffectLimiter.new()
			limiter.threshold_db = -4.0
			limiter.ceiling_db = -0.8
			AudioServer.add_bus_effect(master, limiter)
	var sfx := AudioServer.get_bus_index(BUS_NAME)
	if sfx < 0:
		AudioServer.add_bus()
		sfx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(sfx, BUS_NAME)
		AudioServer.set_bus_send(sfx, "Master")
	AudioServer.set_bus_volume_db(sfx, SFX_BUS_VOLUME_DB)

func _has_limiter(bus_idx: int) -> bool:
	for i in AudioServer.get_bus_effect_count(bus_idx):
		if AudioServer.get_bus_effect(bus_idx, i) is AudioEffectLimiter:
			return true
	return false

func _make_pool() -> void:
	for i in WORLD_VOICES:
		var player := AudioStreamPlayer2D.new()
		player.bus = BUS_NAME
		player.attenuation = WORLD_ATTENUATION
		player.panning_strength = PAN_STRENGTH
		add_child(player)
		player.finished.connect(_on_player_finished.bind(player))
		world_players.append(player)
	for i in UI_VOICES:
		var player := AudioStreamPlayer.new()
		player.bus = BUS_NAME
		add_child(player)
		player.finished.connect(_on_player_finished.bind(player))
		ui_players.append(player)

func _refresh_world_distance() -> void:
	var viewport := get_viewport()
	var size := Vector2(1280.0, 720.0)
	if viewport != null:
		size = viewport.get_visible_rect().size
	# A little wider than the viewport diagonal, but bounded so a large window
	# cannot make distant firefights drown out the local one.
	_world_distance = clampf(maxf(size.x, size.y) * 0.72, 650.0, 1200.0)
	for player in world_players:
		player.max_distance = _world_distance

func _load_streams() -> void:
	for id in SOUND_FILES:
		var choices: Array = []
		for filename in SOUND_FILES[id]:
			var path := "res://assets/sfx/%s" % String(filename)
			if not ResourceLoader.exists(path):
				push_warning("AudioManager: missing %s (run tools/generate_sfx.py and re-import)" % path)
				continue
			var stream = load(path)
			if stream != null:
				choices.append(stream)
		if choices.is_empty():
			push_error("AudioManager: no streams loaded for %s" % id)
		streams[id] = choices
