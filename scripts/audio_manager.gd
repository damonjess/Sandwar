extends Node

## Persistent RTS audio director.
##
## Combat effects come from res://assets/sfx and are played through a bounded
## positional pool. Spoken EVA lines share one queue, Mentat briefings own a
## separate narration player, and two AudioStreamPlayers crossfade the three
## Ogg music beds. Music volume and SFX/voice volume live in user://settings.json.
##
## The music and voice assets are generated by tools/generate_music.py and
## tools/generate_mentat_voices.py. Re-import the project after regenerating.

const SOUND_FILES := {
	"cannon": ["cannon_01.wav", "cannon_02.wav"],
	"rocket_launch": ["rocket_launch_01.wav", "rocket_launch_02.wav"],
	"rifle": ["rifle_01.wav", "rifle_02.wav"],
	"mg_burst": ["mg_burst.wav"],
	"sonic_fire": ["sonic_fire.wav"],
	"plasma_fire": ["plasma_fire.wav"],
	"explosion_small": ["explosion_small_01.wav", "explosion_small_02.wav"],
	"explosion_medium": ["explosion_medium_01.wav", "explosion_medium_02.wav"],
	"explosion_building": ["explosion_building.wav"],
	"build_place": ["build_place.wav"],
	"ui_click": ["ui_click.wav"],
	"build_ready": ["build_ready.wav"],
	"comms_blip": ["comms_blip.wav"],
	"low_power": ["low_power.wav"],
	"worm_roar": ["worm_roar.wav"],
}

## Minimum gap between two instances of the same logical sound, in milliseconds.
const COOLDOWN_MS := {
	"rifle": 45,
	"mg_burst": 55,
	"sonic_fire": 120,
	"plasma_fire": 140,
	"cannon": 60,
	"rocket_launch": 80,
	"explosion_small": 60,
	"explosion_medium": 90,
	"explosion_building": 250,
	"build_place": 90,
	"ui_click": 40,
	"build_ready": 200,
	"comms_blip": 55,
	"low_power": 2500,
	"worm_roar": 1500,
}

## Per-sound concurrency caps keep a 15-unit firefight inside the voice pool.
const MAX_CONCURRENT := {
	"rifle": 4,
	"mg_burst": 4,
	"sonic_fire": 2,
	"plasma_fire": 2,
	"cannon": 3,
	"rocket_launch": 3,
	"explosion_small": 4,
	"explosion_medium": 3,
	"explosion_building": 1,
	"build_place": 2,
	"ui_click": 2,
	"build_ready": 1,
	"comms_blip": 2,
	"low_power": 1,
	"worm_roar": 1,
}

## Spoken EVA radio comms generated by tools/generate_mentat_voices.py. These
## share one dedicated player so two alerts can never talk over each other.
const VOICE_FILES := {
	"enemy_approaching": "voice/enemy_approaching.ogg",
	"base_under_attack": "voice/base_under_attack.ogg",
	"harvester_under_attack": "voice/harvester_under_attack.ogg",
	"construction_complete": "voice/construction_complete.ogg",
	"unit_ready": "voice/unit_ready.ogg",
	"low_power": "voice/low_power.ogg",
	"wormsign": "voice/wormsign.ogg",
	"worm_attack": "voice/worm_attack.ogg",
	"reinforcements": "voice/reinforcements.ogg",
	# Dune 2000 alert set ready for the upcoming systems.
	"silos_needed": "voice/silos_needed.ogg",
	"radar_online": "voice/radar_online.ogg",
	"radar_offline": "voice/radar_offline.ogg",
	"frigate_arrived": "voice/frigate_arrived.ogg",
	"death_hand_launched": "voice/death_hand_launched.ogg",
}
const VOICE_QUEUE_MAX := 3

const MUSIC_FILES := {
	"menu": "menu_arrakis.ogg",
	"ambient": "desert_ambient.ogg",
	"combat": "battle_combat.ogg",
}
const MENU_TRACK := "menu"
const AMBIENT_TRACK := "ambient"
const COMBAT_TRACK := "combat"
const COMBAT_RETURN_SEC := 12.0
const MUSIC_CROSSFADE_SEC := 2.4

## Any of these effects means a real firefight is underway, so the score lifts
## into the battle cue. The cue eases back to the ambient bed after 12 quiet s.
const COMBAT_SOUNDS := {
	"rifle": true,
	"mg_burst": true,
	"sonic_fire": true,
	"plasma_fire": true,
	"cannon": true,
	"rocket_launch": true,
	"explosion_small": true,
	"explosion_medium": true,
	"explosion_building": true,
}

const WORLD_VOICES := 12
const UI_VOICES := 4
const SFX_BUS_NAME := "SFX"
const MUSIC_BUS_NAME := "Music"
const WORLD_ATTENUATION := 1.7
const PAN_STRENGTH := 0.7

const SETTINGS_PATH := "user://settings.json"
const DEFAULT_MUSIC_VOLUME := 0.72
const DEFAULT_SFX_VOLUME := 0.80

## --- Easy tweak points -------------------------------------------------------
## Base bus levels before the player's saved volume multiplier is applied.
const SFX_BUS_VOLUME_DB := -4.0
const MUSIC_BUS_VOLUME_DB := -7.0
const MUTE_ALL_AUDIO := false

const PITCH_MIN := 0.92
const PITCH_MAX := 1.08
const VOLUME_JITTER_DB := 1.2

var streams: Dictionary = {}
var voice_streams: Dictionary = {}
var music_streams: Dictionary = {}
var voice_queue: Array = []
var voice_player: AudioStreamPlayer
var mentat_player: AudioStreamPlayer
var voice_last_ms: Dictionary = {}
var world_players: Array[AudioStreamPlayer2D] = []
var ui_players: Array[AudioStreamPlayer] = []
var music_players: Array[AudioStreamPlayer] = []
var world_i := 0
var ui_i := 0
var last_ms: Dictionary = {}
var rng := RandomNumberGenerator.new()
var _world_distance := 900.0

var music_volume := DEFAULT_MUSIC_VOLUME
var sfx_volume := DEFAULT_SFX_VOLUME
var current_music := ""
var music_mode := "menu"
var active_music_player: AudioStreamPlayer
var _music_tween: Tween
var _combat_until_ms := 0

func _exit_tree() -> void:
	# Release active playbacks and stream references before the audio server tears
	# down, so a last typewriter blip cannot leave an orphan at quit.
	stop_all()
	if _music_tween != null:
		_music_tween.kill()
		_music_tween = null
	for player in music_players:
		player.stop()
		player.stream = null
	music_players.clear()
	streams.clear()
	voice_streams.clear()
	music_streams.clear()

func _ready() -> void:
	rng.randomize()
	_load_settings()
	_setup_bus()
	_load_streams()
	_make_pool()
	_refresh_world_distance()
	var viewport := get_viewport()
	if viewport != null and not viewport.size_changed.is_connected(_refresh_world_distance):
		viewport.size_changed.connect(_refresh_world_distance)
	set_process(true)

func _process(_delta: float) -> void:
	if music_mode == "battle" and current_music == COMBAT_TRACK:
		if Time.get_ticks_msec() >= _combat_until_ms:
			_switch_music(AMBIENT_TRACK, MUSIC_CROSSFADE_SEC)

## Spoken comms alert. One dedicated player plus a short FIFO queue keeps lines
## from overlapping; the per-alert cooldown stops a big battle from repeating
## the same line every few seconds.
func play_voice(id: String, cooldown_sec := 12.0) -> void:
	if MUTE_ALL_AUDIO or not voice_streams.has(id):
		return
	if voice_player == null:
		return
	var now := Time.get_ticks_msec()
	if now - int(voice_last_ms.get(id, -100000000)) < int(cooldown_sec * 1000.0):
		return
	voice_last_ms[id] = now
	if voice_player.playing:
		if voice_queue.size() >= VOICE_QUEUE_MAX:
			return
		voice_queue.append(id)
		return
	_start_voice(id)

func _start_voice(id: String) -> void:
	if voice_player == null or not voice_streams.has(id):
		return
	voice_player.stream = voice_streams[id]
	voice_player.volume_db = 0.0
	voice_player.pitch_scale = 1.0
	voice_player.play()

func _on_voice_finished() -> void:
	voice_player.set_meta("voice_id", "")
	if voice_queue.is_empty():
		return
	var next = voice_queue.pop_front()
	_start_voice(String(next))

## Positional combat/effect sound.
func play_at(id: String, pos: Vector2, volume_db := 0.0, pitch := 1.0) -> void:
	if MUTE_ALL_AUDIO or not _can_play(id):
		return
	if _active_count(world_players, id) >= int(MAX_CONCURRENT.get(id, 2)):
		return
	var player := _next_world_player()
	if player == null:
		return
	var stream = _pick_stream(id)
	if stream == null:
		return
	player.stream = stream
	player.global_position = pos
	player.volume_db = volume_db + rng.randf_range(-VOLUME_JITTER_DB, VOLUME_JITTER_DB)
	player.pitch_scale = clampf(pitch * rng.randf_range(PITCH_MIN, PITCH_MAX), 0.75, 1.25)
	player.set_meta("sfx_id", id)
	player.play()
	if COMBAT_SOUNDS.has(id):
		notify_combat()

## Non-positional UI/feedback sound. Building placement deliberately uses this
## pool so it stays crisp and centered instead of panning around the battlefield.
func play_ui(id: String, volume_db := 0.0, pitch := 1.0) -> void:
	if MUTE_ALL_AUDIO or not _can_play(id):
		return
	if _active_count(ui_players, id) >= int(MAX_CONCURRENT.get(id, 1)):
		return
	var player := _next_ui_player()
	if player == null:
		return
	var stream = _pick_stream(id)
	if stream == null:
		return
	player.stream = stream
	player.volume_db = volume_db + rng.randf_range(-0.5, 0.5)
	player.pitch_scale = clampf(pitch * rng.randf_range(0.97, 1.03), 0.9, 1.1)
	player.set_meta("sfx_id", id)
	player.play()

func _can_play(id: String) -> bool:
	if not streams.has(id):
		return false
	var now := Time.get_ticks_msec()
	var gap := int(COOLDOWN_MS.get(id, 0))
	if now - int(last_ms.get(id, -100000)) < gap:
		return false
	last_ms[id] = now
	return true

func _pick_stream(id: String):
	var choices: Array = streams.get(id, [])
	if choices.is_empty():
		return null
	return choices[rng.randi_range(0, choices.size() - 1)]

func _next_world_player() -> AudioStreamPlayer2D:
	for offset in world_players.size():
		var idx := (world_i + offset) % world_players.size()
		var player: AudioStreamPlayer2D = world_players[idx]
		if not player.playing:
			world_i = (idx + 1) % world_players.size()
			return player
	return null

func _next_ui_player() -> AudioStreamPlayer:
	for offset in ui_players.size():
		var idx := (ui_i + offset) % ui_players.size()
		var player: AudioStreamPlayer = ui_players[idx]
		if not player.playing:
			ui_i = (idx + 1) % ui_players.size()
			return player
	return null

func _active_count(players: Array, id: String) -> int:
	var count := 0
	for player in players:
		if player.playing and String(player.get_meta("sfx_id", "")) == id:
			count += 1
	return count

func _on_player_finished(player) -> void:
	player.set_meta("sfx_id", "")

## Scene changes call this so a battle's gunfire cannot bleed into the next
## mission or the strategic map. Music is deliberately independent: menu and
## battle cues crossfade across scenes instead of restarting. The pooled players
## stay alive for reuse.
func stop_all() -> void:
	voice_queue.clear()
	stop_mentat()
	if voice_player != null:
		voice_player.stop()
		voice_player.stream = null
		voice_player.set_meta("voice_id", "")
	for player in world_players:
		player.stop()
		player.stream = null
		player.set_meta("sfx_id", "")
	for player in ui_players:
		player.stop()
		player.stream = null
		player.set_meta("sfx_id", "")

# ------------------------------------------------------------------ music

## House Select, Arrakis Map and Mentat Briefing share one uninterrupted cue.
func play_menu_music() -> void:
	music_mode = "menu"
	_combat_until_ms = 0
	_switch_music(MENU_TRACK, MUSIC_CROSSFADE_SEC)

## Every battle starts on the harvesting bed. Real combat lifts it into the
## battle cue; _process eases it back after twelve quiet seconds.
func play_battle_music() -> void:
	music_mode = "battle"
	_combat_until_ms = 0
	_switch_music(AMBIENT_TRACK, MUSIC_CROSSFADE_SEC)

## Called by weapon effects automatically and available to gameplay systems
## that want to mark an engagement even when no sample is audible.
func notify_combat() -> void:
	if music_mode != "battle":
		return
	_combat_until_ms = Time.get_ticks_msec() + int(COMBAT_RETURN_SEC * 1000.0)
	if current_music != COMBAT_TRACK:
		_switch_music(COMBAT_TRACK, MUSIC_CROSSFADE_SEC)

func _switch_music(track_id: String, fade: float) -> void:
	if current_music == track_id:
		return
	var stream: AudioStream = music_streams.get(track_id)
	if stream == null:
		push_warning("AudioManager: missing music %s (run tools/generate_music.py and re-import)" % track_id)
		return
	if stream is AudioStreamOggVorbis:
		var ogg := stream as AudioStreamOggVorbis
		ogg.loop = true
		ogg.loop_offset = 0.0
	if music_players.size() < 2:
		return
	if _music_tween != null:
		_music_tween.kill()
		_music_tween = null

	var outgoing := active_music_player
	var incoming: AudioStreamPlayer = music_players[0]
	if outgoing == incoming:
		incoming = music_players[1]
	if incoming.playing:
		incoming.stop()
	incoming.stream = stream
	incoming.volume_db = -80.0
	incoming.play()
	active_music_player = incoming
	current_music = track_id

	_music_tween = create_tween()
	_music_tween.set_parallel(true)
	if outgoing != null and outgoing != incoming and outgoing.playing:
		_music_tween.tween_property(outgoing, "volume_db", -60.0, fade).set_trans(Tween.TRANS_SINE)
	_music_tween.tween_property(incoming, "volume_db", 0.0, fade).set_trans(Tween.TRANS_SINE)
	_music_tween.set_parallel(false)
	if outgoing != null and outgoing != incoming:
		_music_tween.tween_callback(_retire_music_player.bind(outgoing))

func _retire_music_player(player: AudioStreamPlayer) -> void:
	if player == null or player == active_music_player:
		return
	player.stop()
	player.stream = null

# ------------------------------------------------------------------ mentat

func mentat_path(house_id: String, tier: int) -> String:
	return "res://assets/sfx/mentat/%s_mission_%02d.ogg" % [house_id, tier]

func has_mentat(house_id: String, tier: int) -> bool:
	return ResourceLoader.exists(mentat_path(house_id, tier))

## Start (or restart) the active House/Mission briefing narration.
func play_mentat(house_id: String, tier: int) -> bool:
	if mentat_player == null:
		return false
	var path := mentat_path(house_id, tier)
	if not ResourceLoader.exists(path):
		push_warning("AudioManager: missing Mentat voice %s" % path)
		return false
	var stream = load(path)
	if stream == null:
		return false
	mentat_player.stop()
	mentat_player.stream = stream
	mentat_player.volume_db = 0.0
	mentat_player.pitch_scale = 1.0
	mentat_player.play()
	return true

func stop_mentat() -> void:
	if mentat_player == null:
		return
	mentat_player.stop()
	mentat_player.stream = null

func is_mentat_playing() -> bool:
	return mentat_player != null and mentat_player.playing

# ------------------------------------------------------------------ volume

func set_music_volume(value: float, save := true) -> void:
	music_volume = clampf(value, 0.0, 1.0)
	_apply_bus_volumes()
	if save:
		_save_settings()

func set_sfx_volume(value: float, save := true) -> void:
	sfx_volume = clampf(value, 0.0, 1.0)
	_apply_bus_volumes()
	if save:
		_save_settings()

func music_percent() -> int:
	return int(round(music_volume * 100.0))

func sfx_percent() -> int:
	return int(round(sfx_volume * 100.0))

func _load_settings() -> void:
	if not FileAccess.file_exists(SETTINGS_PATH):
		return
	var text := FileAccess.get_file_as_string(SETTINGS_PATH)
	var parsed = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_warning("AudioManager: settings.json is not valid JSON; using defaults")
		return
	var data: Dictionary = parsed
	music_volume = clampf(float(data.get("music_volume", DEFAULT_MUSIC_VOLUME)), 0.0, 1.0)
	sfx_volume = clampf(float(data.get("sfx_volume", DEFAULT_SFX_VOLUME)), 0.0, 1.0)

func _save_settings() -> void:
	var data: Dictionary = {}
	if FileAccess.file_exists(SETTINGS_PATH):
		var parsed = JSON.parse_string(FileAccess.get_file_as_string(SETTINGS_PATH))
		if typeof(parsed) == TYPE_DICTIONARY:
			data = (parsed as Dictionary).duplicate(true)
	data["music_volume"] = music_volume
	data["sfx_volume"] = sfx_volume
	var file := FileAccess.open(SETTINGS_PATH, FileAccess.WRITE)
	if file == null:
		push_warning("AudioManager: could not write %s" % SETTINGS_PATH)
		return
	file.store_string(JSON.stringify(data, "\t"))

func _volume_db(value: float, base_db: float) -> float:
	if value <= 0.001:
		return -80.0
	return base_db + linear_to_db(clampf(value, 0.0, 1.0))

# ------------------------------------------------------------------ setup

func _setup_bus() -> void:
	var master := AudioServer.get_bus_index("Master")
	if master >= 0:
		AudioServer.set_bus_mute(master, MUTE_ALL_AUDIO)
		if not _has_limiter(master):
			var limiter := AudioEffectLimiter.new()
			limiter.threshold_db = -4.0
			limiter.ceiling_db = -0.8
			AudioServer.add_bus_effect(master, limiter)
	var sfx := AudioServer.get_bus_index(SFX_BUS_NAME)
	if sfx < 0:
		AudioServer.add_bus()
		sfx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(sfx, SFX_BUS_NAME)
		AudioServer.set_bus_send(sfx, "Master")
	var music := AudioServer.get_bus_index(MUSIC_BUS_NAME)
	if music < 0:
		AudioServer.add_bus()
		music = AudioServer.bus_count - 1
		AudioServer.set_bus_name(music, MUSIC_BUS_NAME)
		AudioServer.set_bus_send(music, "Master")
	_apply_bus_volumes()

func _apply_bus_volumes() -> void:
	var sfx := AudioServer.get_bus_index(SFX_BUS_NAME)
	if sfx >= 0:
		AudioServer.set_bus_volume_db(sfx, _volume_db(sfx_volume, SFX_BUS_VOLUME_DB))
	var music := AudioServer.get_bus_index(MUSIC_BUS_NAME)
	if music >= 0:
		AudioServer.set_bus_volume_db(music, _volume_db(music_volume, MUSIC_BUS_VOLUME_DB))

func _has_limiter(bus_idx: int) -> bool:
	for i in AudioServer.get_bus_effect_count(bus_idx):
		if AudioServer.get_bus_effect(bus_idx, i) is AudioEffectLimiter:
			return true
	return false

func _make_pool() -> void:
	voice_player = AudioStreamPlayer.new()
	voice_player.bus = SFX_BUS_NAME
	add_child(voice_player)
	voice_player.finished.connect(_on_voice_finished)
	mentat_player = AudioStreamPlayer.new()
	mentat_player.bus = SFX_BUS_NAME
	add_child(mentat_player)
	for i in WORLD_VOICES:
		var player := AudioStreamPlayer2D.new()
		player.bus = SFX_BUS_NAME
		player.attenuation = WORLD_ATTENUATION
		player.panning_strength = PAN_STRENGTH
		add_child(player)
		player.finished.connect(_on_player_finished.bind(player))
		world_players.append(player)
	for i in UI_VOICES:
		var player := AudioStreamPlayer.new()
		player.bus = SFX_BUS_NAME
		add_child(player)
		player.finished.connect(_on_player_finished.bind(player))
		ui_players.append(player)
	for i in 2:
		var player := AudioStreamPlayer.new()
		player.bus = MUSIC_BUS_NAME
		player.volume_db = -80.0
		add_child(player)
		music_players.append(player)

func _refresh_world_distance() -> void:
	var viewport := get_viewport()
	var size := Vector2(1280.0, 720.0)
	if viewport != null:
		size = viewport.get_visible_rect().size
	# A little wider than the viewport diagonal, but bounded so a large window
	# cannot make distant firefights drown out the local one.
	_world_distance = clampf(maxf(size.x, size.y) * 0.72, 650.0, 1200.0)
	for player in world_players:
		player.max_distance = _world_distance

func _load_streams() -> void:
	for id in VOICE_FILES:
		var vpath := "res://assets/sfx/%s" % String(VOICE_FILES[id])
		if not ResourceLoader.exists(vpath):
			push_warning("AudioManager: missing voice %s (run tools/generate_mentat_voices.py and re-import)" % vpath)
			continue
		var vstream = load(vpath)
		if vstream != null:
			voice_streams[id] = vstream
	for id in MUSIC_FILES:
		var mpath := "res://assets/music/%s" % String(MUSIC_FILES[id])
		if not ResourceLoader.exists(mpath):
			push_warning("AudioManager: missing music %s (run tools/generate_music.py and re-import)" % mpath)
			continue
		var mstream = load(mpath)
		if mstream != null:
			music_streams[id] = mstream
	for id in SOUND_FILES:
		var choices: Array = []
		for filename in SOUND_FILES[id]:
			var path := "res://assets/sfx/%s" % String(filename)
			if not ResourceLoader.exists(path):
				push_warning("AudioManager: missing %s (run tools/generate_sfx.py and re-import)" % path)
				continue
			var stream = load(path)
			if stream != null:
				choices.append(stream)
		if choices.is_empty():
			push_error("AudioManager: no streams loaded for %s" % id)
		streams[id] = choices
