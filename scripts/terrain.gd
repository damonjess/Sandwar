class_name Terrain
extends Node2D

## Tile grid: cream desert, terracotta rock mesas and rust spice fields.
##
## The palette follows the Dune 2000 Atreides read: high-key sand, warm
## buildable stone, dark crag transitions and concrete that belongs to the
## same desert instead of reading as a separate grey tileset.

const SAND_LIGHT := Color("e6cca3")
const SAND_DARK := Color("d8b888")
const ROCK_LIGHT := Color("c87e4e")
const ROCK_DARK := Color("ba6d3e")
const CLIFF := Color(0.40, 0.22, 0.12)
const CLIFF_DARK := Color(0.16, 0.08, 0.04)
const SLAB := Color("c99a74")
const SLAB_INNER := Color("d7b18d")

var types := PackedByteArray()
var seen := PackedByteArray()
var lit := PackedByteArray()
var spice := PackedFloat32Array()
var spice_max := PackedFloat32Array()
var concrete := PackedByteArray()
var regrow := 0.0

var sand_tint: FastNoiseLite
var rock_tint: FastNoiseLite

## Baked tile strips (40 px cells). The cliff atlas is a 16-frame autotile: one
## frame for every combination of orthogonal rock neighbours (N=1 E=2 S=4 W=8).
## Concrete is re-baked by tools/bake_buildings_3d.gd at the same time as the
## buildings, so the slab seams and the structure foundations share a palette.
const TEX_SAND := "res://assets/sprites/d2/terrain_sand.png"
const TEX_ROCK := "res://assets/sprites/d2/terrain_rock.png"
## New seamless bases remove the old 40 px tint cells in the source sheets.
## The original files are kept untouched as fallbacks.
const TEX_SAND_CLEAN := "res://assets/sprites/d2/terrain_sand_clean.png"
const TEX_ROCK_CLEAN := "res://assets/sprites/d2/terrain_rock_clean.png"
## Soft-edged, deterministic detail variants composited over the continuous
## sheets. They share a feathered alpha=0 border, so no variant can create a
## tile seam or a 40 px square grid.
const TEX_SAND_VARIANTS := "res://assets/sprites/d2/terrain_sand_variants.png"
const TEX_ROCK_VARIANTS := "res://assets/sprites/d2/terrain_rock_variants.png"
const TEX_CONCRETE := "res://assets/sprites/buildings/slab_pavement.png"
const TEX_SPICE := "res://assets/sprites/d2/terrain_spice.png"
## Soft, feathered 96 px spice blooms generated by tools/generate_terrain_variants.py.
## They are deliberately larger than one 40 px tile and overlap their neighbours.
const TEX_SPICE_BLOOMS := "res://assets/sprites/d2/terrain_spice_blooms.png"
const SPICE_BLOOM_CELL := 96.0
const SPICE_DUST_VARIANTS := 4
const SPICE_CORE_VARIANTS := 4
const TEX_CLIFF := "res://assets/sprites/d2/terrain_cliff.png"
const CLIFF_N := 1
const CLIFF_E := 2
const CLIFF_S := 4
const CLIFF_W := 8

var sand_tex: Texture2D
var rock_tex: Texture2D
var sand_clean_tex: Texture2D
var rock_clean_tex: Texture2D
var sand_variants: Texture2D
var rock_variants: Texture2D
var concrete_tex: Texture2D
var spice_tex: Texture2D
var spice_blooms_tex: Texture2D
var cliff_tex: Texture2D
var variant_seed := 0

func _ready() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
	sand_tex = _load_tex(TEX_SAND)
	rock_tex = _load_tex(TEX_ROCK)
	sand_clean_tex = _load_tex(TEX_SAND_CLEAN)
	rock_clean_tex = _load_tex(TEX_ROCK_CLEAN)
	sand_variants = _load_tex(TEX_SAND_VARIANTS)
	rock_variants = _load_tex(TEX_ROCK_VARIANTS)
	concrete_tex = _load_tex(TEX_CONCRETE)
	spice_tex = _load_tex(TEX_SPICE)
	spice_blooms_tex = _load_tex(TEX_SPICE_BLOOMS)
	cliff_tex = _load_tex(TEX_CLIFF)

static func _load_tex(path: String) -> Texture2D:
	return load(path) if ResourceLoader.exists(path) else null

func generate(seed_value: int) -> void:
	variant_seed = seed_value
	var total := GameDefs.MAP * GameDefs.MAP
	types.resize(total)
	types.fill(GameDefs.SAND)
	spice.resize(total)
	spice.fill(0.0)
	spice_max.resize(total)
	spice_max.fill(0.0)
	concrete.resize(total)
	concrete.fill(0)
	seen.resize(total)
	seen.fill(0)
	lit.resize(total)
	lit.fill(0)

	var rock_noise := FastNoiseLite.new()
	rock_noise.seed = seed_value
	rock_noise.frequency = 0.045
	rock_noise.fractal_octaves = 3

	var spice_noise := FastNoiseLite.new()
	spice_noise.seed = seed_value + 977
	spice_noise.frequency = 0.08

	# Soft wide noise so the desert shades in dunes instead of one flat colour.
	sand_tint = FastNoiseLite.new()
	sand_tint.seed = seed_value + 31
	sand_tint.frequency = 0.09
	sand_tint.fractal_octaves = 2
	rock_tint = FastNoiseLite.new()
	rock_tint.seed = seed_value + 57
	rock_tint.frequency = 0.16
	rock_tint.fractal_octaves = 2

	for y in GameDefs.MAP:
		for x in GameDefs.MAP:
			var i := y * GameDefs.MAP + x
			if rock_noise.get_noise_2d(float(x), float(y)) > 0.24:
				types[i] = GameDefs.ROCK
			var s := spice_noise.get_noise_2d(float(x) + 300.0, float(y) + 300.0)
			if s > 0.30 and types[i] == GameDefs.SAND:
				var amount := clampf((s - 0.30) * 620.0, 60.0, 260.0)
				spice[i] = amount
				spice_max[i] = amount

	# Guaranteed rock plateaus under both starting bases, scaled with the
	# mission's battlefield so 44, 52 and 60 tile maps all have fair ground.
	var player_base := Vector2i(int(round(float(GameDefs.MAP) * 0.30)), int(round(float(GameDefs.MAP) * 0.73)))
	var enemy_base := Vector2i(int(round(float(GameDefs.MAP) * 0.75)), int(round(float(GameDefs.MAP) * 0.27)))
	_force_rock(player_base, maxi(8, int(round(float(GameDefs.MAP) * 0.18))))
	_force_rock(enemy_base, maxi(8, int(round(float(GameDefs.MAP) * 0.19))))
	# Spice fields close enough to reach in the opening minute.
	_add_spice(Vector2i(int(round(float(GameDefs.MAP) * 0.58)), int(round(float(GameDefs.MAP) * 0.84))), maxi(4, int(round(float(GameDefs.MAP) * 0.09))))
	_add_spice(Vector2i(int(round(float(GameDefs.MAP) * 0.47)), int(round(float(GameDefs.MAP) * 0.54))), maxi(5, int(round(float(GameDefs.MAP) * 0.11))))
	_add_spice(Vector2i(int(round(float(GameDefs.MAP) * 0.58)), int(round(float(GameDefs.MAP) * 0.39))), maxi(5, int(round(float(GameDefs.MAP) * 0.11))))
	queue_redraw()

func _force_rock(center: Vector2i, radius: int) -> void:
	for y in range(center.y - radius, center.y + radius + 1):
		for x in range(center.x - radius, center.x + radius + 1):
			if not in_bounds(x, y):
				continue
			if Vector2i(x, y).distance_to(center) <= float(radius):
				var i := y * GameDefs.MAP + x
				types[i] = GameDefs.ROCK
				spice[i] = 0.0
				spice_max[i] = 0.0

func _add_spice(center: Vector2i, radius: int) -> void:
	for y in range(center.y - radius, center.y + radius + 1):
		for x in range(center.x - radius, center.x + radius + 1):
			if not in_bounds(x, y):
				continue
			var d := Vector2i(x, y).distance_to(center)
			if d > float(radius):
				continue
			var i := y * GameDefs.MAP + x
			types[i] = GameDefs.SAND
			var amount := 110.0 + 16.0 * (float(radius) - d)
			spice[i] = maxf(spice[i], amount)
			spice_max[i] = maxf(spice_max[i], amount)

func in_bounds(x: int, y: int) -> bool:
	return x >= 0 and y >= 0 and x < GameDefs.MAP and y < GameDefs.MAP

## Open desert: sand with no concrete slab. Sandworms may only occupy this.
func is_open_sand(tile: Vector2i) -> bool:
	if not in_bounds(tile.x, tile.y):
		return false
	var i := tile.y * GameDefs.MAP + tile.x
	return types[i] == GameDefs.SAND and concrete[i] == 0

# ------------------------------------------------------------------- vision

func clear_visible() -> void:
	lit.fill(0)

## Light every tile within radius of pos; also sets the remembered "seen" flag.
func reveal(pos: Vector2, radius: float) -> void:
	var t := float(GameDefs.TILE)
	var cx := int(pos.x / t)
	var cy := int(pos.y / t)
	var reach := int(ceil(radius / t))
	var r2 := radius * radius
	for y in range(cy - reach, cy + reach + 1):
		for x in range(cx - reach, cx + reach + 1):
			if not in_bounds(x, y):
				continue
			var dx := (float(x) + 0.5) * t - pos.x
			var dy := (float(y) + 0.5) * t - pos.y
			if dx * dx + dy * dy > r2:
				continue
			var i := y * GameDefs.MAP + x
			lit[i] = 1
			seen[i] = 1

func is_visible_tile(x: int, y: int) -> bool:
	if not in_bounds(x, y):
		return false
	return lit[y * GameDefs.MAP + x] == 1

func is_visible_at(pos: Vector2) -> bool:
	var tile := tile_of(pos)
	return is_visible_tile(tile.x, tile.y)

func is_seen_tile(x: int, y: int) -> bool:
	if not in_bounds(x, y):
		return false
	return seen[y * GameDefs.MAP + x] == 1

func tile_of(pos: Vector2) -> Vector2i:
	return Vector2i(int(floor(pos.x / float(GameDefs.TILE))), int(floor(pos.y / float(GameDefs.TILE))))

func tile_center(tile: Vector2i) -> Vector2:
	return Vector2(tile) * float(GameDefs.TILE) + Vector2(GameDefs.TILE, GameDefs.TILE) * 0.5

func is_tile_buildable(tx: int, ty: int) -> bool:
	if not in_bounds(tx, ty):
		return false
	var i := ty * GameDefs.MAP + tx
	if spice[i] >= 5.0:
		return false
	return types[i] == GameDefs.ROCK or concrete[i] == 1

func can_pave(tile: Vector2i) -> bool:
	if not in_bounds(tile.x, tile.y):
		return false
	var i := tile.y * GameDefs.MAP + tile.x
	return concrete[i] == 0 and spice[i] < 5.0

func pave(tile: Vector2i) -> void:
	if not in_bounds(tile.x, tile.y):
		return
	concrete[tile.y * GameDefs.MAP + tile.x] = 1
	queue_redraw()

func pave_rect(tile: Vector2i, size: int) -> void:
	pave_span(tile, Vector2i(size, size))

func pave_span(tile: Vector2i, span: Vector2i) -> void:
	for ty in range(tile.y, tile.y + span.y):
		for tx in range(tile.x, tile.x + span.x):
			if in_bounds(tx, ty):
				concrete[ty * GameDefs.MAP + tx] = 1
	queue_redraw()

func spice_at(tile: Vector2i) -> float:
	if not in_bounds(tile.x, tile.y):
		return 0.0
	return spice[tile.y * GameDefs.MAP + tile.x]

func take_spice(tile: Vector2i, amount: float) -> float:
	if not in_bounds(tile.x, tile.y):
		return 0.0
	var i := tile.y * GameDefs.MAP + tile.x
	var taken := minf(spice[i], amount)
	spice[i] -= taken
	return taken

func find_spice_tile(from: Vector2i, max_radius: int = 40) -> Vector2i:
	var best := Vector2i(-1, -1)
	var best_d := 1.0e9
	var limit := float(max_radius * max_radius)
	for y in GameDefs.MAP:
		for x in GameDefs.MAP:
			var i := y * GameDefs.MAP + x
			if spice[i] < 10.0:
				continue
			var d := Vector2(float(x - from.x), float(y - from.y)).length_squared()
			if d < best_d and d <= limit:
				best_d = d
				best = Vector2i(x, y)
	return best

func _process(delta: float) -> void:
	regrow += delta
	if regrow < 2.0:
		return
	regrow = 0.0
	var changed := false
	for i in spice.size():
		if spice_max[i] > 0.0 and spice[i] < spice_max[i]:
			spice[i] = minf(spice_max[i], spice[i] + 1.5)
			changed = true
	if changed:
		queue_redraw()

func _hash(x: int, y: int) -> int:
	return abs((x * 73856093) ^ (y * 19349663))

func _is_sand(x: int, y: int) -> bool:
	if not in_bounds(x, y):
		return false
	return types[y * GameDefs.MAP + x] == GameDefs.SAND

func _is_rock(x: int, y: int) -> bool:
	if not in_bounds(x, y):
		return false
	return types[y * GameDefs.MAP + x] == GameDefs.ROCK

## Neighbour mask used by the 16-frame cliff atlas. Missing bits are exposed
## mesa edges; corners therefore receive both the south face and the side rim
## in one blend instead of leaving square gaps.
func cliff_mask(x: int, y: int) -> int:
	var mask := 0
	if _is_rock(x, y - 1):
		mask |= CLIFF_N
	if _is_rock(x + 1, y):
		mask |= CLIFF_E
	if _is_rock(x, y + 1):
		mask |= CLIFF_S
	if _is_rock(x - 1, y):
		mask |= CLIFF_W
	return mask

## Stable variant choice from the map seed and grid coordinate. No RNG state
## is involved, so the same tile always gets the same variant across redraws.
func _variant_index(x: int, y: int, count: int) -> int:
	if count <= 1:
		return 0
	var h := _hash(x, y) ^ (variant_seed * 2654435761)
	h = absi(h ^ (h >> 13))
	return posmod(h, count)


func _draw_variant(tex: Texture2D, variant: int, pos: Vector2, tile_size: Vector2) -> void:
	if tex == null:
		return
	var count := maxi(tex.get_width() / GameDefs.TILE, 1)
	if count <= 0:
		return
	var v := clampi(variant, 0, count - 1)
	draw_texture_rect_region(tex, Rect2(pos, tile_size),
		Rect2(Vector2(float(v * GameDefs.TILE), 0.0), tile_size))


func _draw() -> void:
	if sand_tint == null:
		return
	var m := GameDefs.MAP
	var t := float(GameDefs.TILE)
	var tile_size := Vector2(t, t)

	# One continuous seamless desert sheet behind the whole map; the plateau
	# and slab passes sit on top of it. Prefer the clean generated sheet when
	# present: it has no legacy 40 px tint cells or vertical source seam.
	var sand_base := sand_clean_tex if sand_clean_tex != null else sand_tex
	if sand_base != null:
		draw_texture_rect(sand_base, Rect2(Vector2.ZERO, Vector2(GameDefs.WORLD, GameDefs.WORLD)), true)

	for y in m:
		for x in m:
			var i := y * m + x
			var pos := Vector2(float(x), float(y)) * t
			if concrete[i] == 1:
				if concrete_tex != null:
					# Each tile is one baked plate; the sheet contains four variants
					# so long runs of concrete do not look stamped.
					var variants := maxi(concrete_tex.get_width() / GameDefs.TILE, 1)
					var variant := _hash(x, y) % variants
					draw_texture_rect_region(concrete_tex, Rect2(pos, tile_size),
						Rect2(Vector2(float(variant * GameDefs.TILE), 0.0), tile_size))
				else:
					draw_rect(Rect2(pos, tile_size), SLAB)
					draw_rect(Rect2(pos + Vector2(2, 2), tile_size - Vector2(4, 4)), SLAB_INNER)
			elif types[i] == GameDefs.ROCK:
				var plateau_tex := rock_clean_tex if rock_clean_tex != null else rock_tex
				if plateau_tex != null:
					# Sample the seamless sheet in world space, so adjacent plateau
					# tiles are continuous instead of a mosaic of 40 px stamps.
					var rx := (x * GameDefs.TILE) % plateau_tex.get_width()
					var ry := (y * GameDefs.TILE) % plateau_tex.get_height()
					draw_texture_rect_region(plateau_tex, Rect2(pos, tile_size),
						Rect2(Vector2(float(rx), float(ry)), tile_size))
				else:
					var rn2 := rock_tint.get_noise_2d(float(x), float(y))
					draw_rect(Rect2(pos, tile_size), ROCK_LIGHT.lerp(ROCK_DARK, clampf(0.5 + rn2 * 0.7, 0.0, 1.0)))
				if rock_variants != null:
					_draw_variant(rock_variants, _variant_index(x, y, rock_variants.get_width() / GameDefs.TILE), pos, tile_size)
			else:
				if sand_tex == null:
					var sn2 := sand_tint.get_noise_2d(float(x), float(y))
					draw_rect(Rect2(pos, tile_size), SAND_LIGHT.lerp(SAND_DARK, clampf(0.5 + sn2 * 0.6, 0.0, 1.0)))
				if sand_variants != null:
					_draw_variant(sand_variants, _variant_index(x, y, sand_variants.get_width() / GameDefs.TILE), pos, tile_size)

	# A warm 1 px dust fringe on the outer concrete lip softens the hard black
	# outline where a pad meets raw rock or sand. This is purely decorative.
	for y in m:
		for x in m:
			if concrete[y * m + x] == 0:
				continue
			var pos := Vector2(float(x), float(y)) * t
			var fringe := Color(0.48, 0.28, 0.15, 0.20)
			if x == 0 or concrete[y * m + x - 1] == 0:
				draw_rect(Rect2(pos, Vector2(1.5, t)), fringe)
			if x == m - 1 or concrete[y * m + x + 1] == 0:
				draw_rect(Rect2(pos + Vector2(t - 1.5, 0.0), Vector2(1.5, t)), fringe)
			if y == 0 or concrete[(y - 1) * m + x] == 0:
				draw_rect(Rect2(pos, Vector2(t, 1.5)), fringe)
			if y == m - 1 or concrete[(y + 1) * m + x] == 0:
				draw_rect(Rect2(pos + Vector2(0.0, t - 1.5), Vector2(t, 1.5)), fringe)

	# Plateau edges: one jagged 16-mask cliff tile per exposed mesa lip. The
	# atlas supplies the south rock face, shaded east wall and sunlit N/W rim;
	# separate cast shadows fall onto the lower desert below and to the right.
	for y in m:
		for x in m:
			if types[y * m + x] != GameDefs.ROCK:
				continue
			var pos := Vector2(float(x), float(y)) * t
			var mask := cliff_mask(x, y)
			if cliff_tex != null and cliff_tex.get_width() >= (mask + 1) * GameDefs.TILE:
				draw_texture_rect_region(cliff_tex, Rect2(pos, tile_size),
					Rect2(Vector2(float(mask * GameDefs.TILE), 0.0), tile_size))
			else:
				if not (mask & CLIFF_S):
					draw_rect(Rect2(pos + Vector2(0, t - 14), Vector2(t, 14)), CLIFF)
					draw_rect(Rect2(pos + Vector2(0, t), Vector2(t, 5)), Color(0, 0, 0, 0.20))
				if not (mask & CLIFF_N):
					draw_rect(Rect2(pos, Vector2(t, 2)), Color(0.80, 0.74, 0.60, 0.45))
				if not (mask & CLIFF_W):
					draw_rect(Rect2(pos, Vector2(2, t)), Color(0.72, 0.65, 0.52, 0.30))
				if not (mask & CLIFF_E):
					draw_rect(Rect2(pos + Vector2(t - 2, 0), Vector2(2, t)), Color(0.12, 0.10, 0.08, 0.34))
			# Cast shadow on the lower sand, offset south-east from the NW key.
			if not _is_rock(x, y + 1):
				draw_rect(Rect2(pos + Vector2(0.0, t), Vector2(t, 5.0)), Color(0.09, 0.04, 0.02, 0.22))
				draw_rect(Rect2(pos + Vector2(0.0, t + 5.0), Vector2(t, 3.0)), Color(0.09, 0.04, 0.02, 0.10))
			if not _is_rock(x + 1, y):
				draw_rect(Rect2(pos + Vector2(t, 0.0), Vector2(4.0, t)), Color(0.09, 0.04, 0.02, 0.15))

	# Spice overlay: overlapping feathered blooms, not square tile stamps.
	if spice_blooms_tex != null:
		_draw_spice_blooms(m, t)
	else:
		_draw_legacy_spice(m, t)

	draw_rect(Rect2(Vector2.ZERO, Vector2(GameDefs.WORLD, GameDefs.WORLD)), Color(0.08, 0.07, 0.05), false, 4.0)

func _spice_jitter(x: int, y: int, salt: int) -> Vector2:
	var h := _hash(x + salt * 13, y - salt * 7)
	return Vector2(float(h % 41) / 40.0 - 0.5,
		float((h / 41) % 41) / 40.0 - 0.5) * 14.0

func _draw_spice_cell(index: int, center: Vector2, size: float, alpha: float) -> void:
	var cell := SPICE_BLOOM_CELL
	draw_texture_rect_region(spice_blooms_tex,
		Rect2(center - Vector2(size, size) * 0.5, Vector2(size, size)),
		Rect2(Vector2(float(index) * cell, 0.0), Vector2(cell, cell)),
		Color(1.0, 1.0, 1.0, clampf(alpha, 0.0, 1.0)))

## Two passes keep the field continuous: a light dusty halo under every spice
## tile first, then a tight deep-rust core only where the tile is rich. The
## 96 px stamps are jittered and larger than the 40 px grid, so their soft
## edges overlap in every direction and no 90-degree tile border is visible.
func _draw_spice_blooms(m: int, t: float) -> void:
	for y in m:
		for x in m:
			var amount := spice[y * m + x]
			if amount <= 4.0:
				continue
			var center := Vector2(float(x) + 0.5, float(y) + 0.5) * t
			var density := clampf((amount - 4.0) / 220.0, 0.0, 1.0)
			var dust := _variant_index(x, y, SPICE_DUST_VARIANTS)
			var size := lerpf(82.0, 104.0, density)
			var alpha := lerpf(0.58, 0.90, pow(density, 0.72))
			_draw_spice_cell(dust, center + _spice_jitter(x, y, 0), size, alpha)

	for y in m:
		for x in m:
			var amount := spice[y * m + x]
			if amount < 88.0:
				continue
			var center := Vector2(float(x) + 0.5, float(y) + 0.5) * t
			var density := clampf((amount - 88.0) / 150.0, 0.0, 1.0)
			var core := SPICE_DUST_VARIANTS + _variant_index(x, y, SPICE_CORE_VARIANTS)
			var size := lerpf(58.0, 84.0, density)
			var alpha := lerpf(0.56, 0.98, density)
			_draw_spice_cell(core, center + _spice_jitter(x, y, 17), size, alpha)

func _draw_legacy_spice(m: int, t: float) -> void:
	for y in m:
		for x in m:
			var amount := spice[y * m + x]
			if amount <= 4.0:
				continue
			var pos := Vector2(float(x), float(y)) * t
			if spice_tex != null:
				var sidx := _hash(x, y) % 4
				var a := clampf(amount / 150.0, 0.22, 0.95)
				draw_texture_rect_region(spice_tex, Rect2(pos, Vector2(t, t)), _atlas(sidx, 4), Color(1, 1, 1, a))
			else:
				draw_rect(Rect2(pos, Vector2(t, t)), Color(0.66, 0.27, 0.08, 0.16 + clampf(amount / 170.0, 0.0, 1.0) * 0.50))

func _atlas(index: int, cols: int) -> Rect2:
	return Rect2(Vector2(float(index % cols), float(index / cols)) * float(GameDefs.TILE),
		Vector2(GameDefs.TILE, GameDefs.TILE))
