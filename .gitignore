# Local Python tooling virtualenv — never commit
.tools-venv/

# Downloaded Piper voice models — large binaries, not shipped
tools/voices/

# Godot's local import/editor cache — regenerated when the project opens
.godot/

# Local build, bake and test artifacts — regenerated by tools/export
build/

# Scratch art crops
assets/sprites/units/*_crop.png*

# Python bytecode from the bake/generation tools
__pycache__/
*.pyc
